name: Supabase keep-alive
# The free Supabase plan pauses a project after 7 days without requests. One small call a day keeps it awake.
# The key below is the publishable key - public by design (it is in the page too).
on:
  schedule:
    - cron: '17 4 * * *'     # daily ~05:17 Slovenian winter time
  workflow_dispatch: {}
permissions: {}
jobs:
  ping:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - name: Ping the database
        run: |
          for i in 1 2 3; do
            code=$(curl -s -o out.txt -w '%{http_code}' -X POST \
              -H "apikey: sb_publishable_yYpHRC0Rdo0L1Mpq3xS9ZQ_HewnusvY" -H "Content-Type: application/json" -d '{}' \
              https://txprpjrwnrchevknvxci.supabase.co/rest/v1/rpc/ping)
            echo "HTTP $code: $(cat out.txt)"
            [ "$code" = "200" ] && exit 0
            sleep 30
          done
          echo "::error::Supabase did not answer - is the project paused? Restore it in the Supabase dashboard."; exit 1
